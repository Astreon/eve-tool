{
    "name": "eve-tool-backend",
    "version": "0.0.1",
    "description": "Backend for Eve Tool",
    "type": "module",
    "main": "server.js",
    "scripts": {
        "dev": "tsx --watch --env-file .env src/server.ts",
        "start": "node --env-file .env dist/server.js",
        "build": "tsc",
        "type-check": "tsc --noEmit && tsc -p tests/.tsconfig.json --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "prettier": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:push": "npx prisma db push",
        "sde:install": "npx tsx --env-file .env sde/installer.ts install",
        "sde:import": "npx tsx --env-file .env sde/installer.ts import",
        "sde:calculate": "npx tsx --env-file .env sde/installer.ts calculate",
        "sde:update": "npx tsx --env-file .env sde/installer.ts update",
        "sde:download": "npx tsx --env-file .env sde/installer.ts download",
        "postinstall": "prisma generate"
    },
    "keywords": [],
    "author": "Astreon",
    "license": "CC-BY-NC-SA-4.0",
    "dependencies": {
        "@prisma/adapter-pg": "^7.0.1",
        "@prisma/client": "^7.1.0",
        "axios": "^1.13.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "extract-zip": "^2.0.1",
        "ioredis": "^5.8.2",
        "pino": "^10.1.0",
        "pino-pretty": "^13.1.2",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.4",
        "@types/extract-zip": "^2.0.0",
        "@types/node": "^24.9.1",
        "@types/pino": "^7.0.4",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "nock": "^14.0.10",
        "prettier": "^3.6.2",
        "prisma": "^7.1.0",
        "supertest": "^7.1.4",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2",
        "vitest": "^4.0.6"
    }
}
