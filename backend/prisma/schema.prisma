// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["sde", "public"]
}

model Character {
  id             Int       @id
  name           String    @unique
  birthday       DateTime
  bloodlineId    Int
  corporationId  Int
  allianceId     Int?
  raceId         Int
  factionId      Int?
  securityStatus Float?
  gender         String
  title          String?
  description    String?   @db.Text
  etag           String?   @db.Text
  lastModified   DateTime?
  expiresAt      DateTime?
  updatedAt      DateTime  @updatedAt

  User      User?
  bloodline Bloodline @relation(fields: [bloodlineId], references: [id])
  faction   Faction?  @relation(fields: [factionId], references: [id])
  race      Race      @relation(fields: [raceId], references: [id])

  @@index([expiresAt])
  @@schema("public")
}

model User {
  id                  Int      @id @default(autoincrement())
  characterId         Int      @unique
  characterName       String
  scopes              String   @db.Text
  refreshToken        String?  @db.Text
  lastLoginAt         DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  onboardingCompleted Boolean  @default(false)

  character Character @relation(fields: [characterId], references: [id])

  @@schema("public")
}

model RegionLink {
  id           Int @id @default(autoincrement())
  fromRegionId Int
  toRegionId   Int

  fromRegion Region @relation("RegionLinkFrom", fields: [fromRegionId], references: [id])
  toRegion   Region @relation("RegionLinkTo", fields: [toRegionId], references: [id])

  @@unique([fromRegionId, toRegionId])
  @@schema("public")
}

model ConstellationLink {
  id                  Int @id @default(autoincrement())
  fromConstellationId Int
  toConstellationId   Int

  fromConstellation Constellation @relation("ConstellationLinkFrom", fields: [fromConstellationId], references: [id])
  toConstellation   Constellation @relation("ConstellationLinkTo", fields: [toConstellationId], references: [id])

  @@unique([fromConstellationId, toConstellationId])
  @@schema("public")
}

enum SystemBorderType {
  INTERNAL
  CONSTELLATION
  REGION

  @@schema("public")
}

model SystemLink {
  id           Int              @id @default(autoincrement())
  fromSystemId Int
  toSystemId   Int
  borderType   SystemBorderType @default(INTERNAL)

  fromSystem SolarSystem @relation("SystemLinkFrom", fields: [fromSystemId], references: [id])
  toSystem   SolarSystem @relation("SystemLinkTo", fields: [toSystemId], references: [id])

  @@unique([fromSystemId, toSystemId])
  @@schema("public")
}

model RegionSystemLayout {
  mapRegionId Int
  systemId    Int
  layoutMode  String   @default("optimized")
  x           Float
  y           Float
  isLocked    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  mapRegion Region      @relation(fields: [mapRegionId], references: [id])
  system    SolarSystem @relation(fields: [systemId], references: [id])

  @@id([mapRegionId, systemId, layoutMode])
  @@index([systemId, layoutMode])
  @@schema("public")
}

/**
 * SDE Export from CCP
 */
model Version {
  key         String   @id
  buildNumber Int      @unique
  releaseDate DateTime

  @@schema("sde")
}

model VersionDataset {
  id        String   @id
  fileName  String
  fileHash  String
  updatedAt DateTime @updatedAt

  @@schema("sde")
}

model Bloodline {
  id          Int     @id
  name        String  @unique
  description String?

  character Character[]

  @@schema("sde")
}

model Race {
  id          Int     @id
  name        String  @unique
  description String?

  character Character[]

  @@schema("sde")
}

model Faction {
  id            Int    @id
  name          String @unique
  description   String
  corporationId Int?
  solarSystemId Int

  regions        Region[]
  constellations Constellation[]
  solarSystems   SolarSystem[]
  Character      Character[]

  @@schema("sde")
}

model SolarSystem {
  id              Int    @id
  name            String @unique
  securityStatus  Float
  securityClass   String @default("")
  constellationId Int
  regionId        Int
  factionId       Int?
  starId          Int?
  x               Float
  y               Float
  z               Float

  stargates           Stargate[]
  planets             Planet[]
  moons               Moon[]
  regionSystemLayouts RegionSystemLayout[]
  region              Region               @relation(fields: [regionId], references: [id])
  faction             Faction?             @relation(fields: [factionId], references: [id])
  constellation       Constellation        @relation(fields: [constellationId], references: [id])

  linksFrom SystemLink[] @relation("SystemLinkFrom")
  linksTo   SystemLink[] @relation("SystemLinkTo")

  @@schema("sde")
}

model Constellation {
  id        Int    @id
  name      String @unique
  factionId Int?
  regionId  Int
  x         Float
  y         Float
  z         Float

  solarSystems SolarSystem[]
  faction      Faction?      @relation(fields: [factionId], references: [id])
  region       Region        @relation(fields: [regionId], references: [id])

  linksFrom ConstellationLink[] @relation("ConstellationLinkFrom")
  linksTo   ConstellationLink[] @relation("ConstellationLinkTo")

  @@schema("sde")
}

model Region {
  id          Int     @id
  name        String  @unique
  description String?
  factionId   Int?
  x           Float
  y           Float
  z           Float

  constellations      Constellation[]
  solarSystems        SolarSystem[]
  regionSystemLayouts RegionSystemLayout[]
  faction             Faction?             @relation(fields: [factionId], references: [id])

  linksFrom RegionLink[] @relation("RegionLinkFrom")
  linksTo   RegionLink[] @relation("RegionLinkTo")

  @@schema("sde")
}

model Stargate {
  id                Int   @id
  solarSystemId     Int
  destSolarSystemId Int
  destStargateId    Int
  typeId            Int
  x                 Float
  y                 Float
  z                 Float

  solarSystem SolarSystem @relation(fields: [solarSystemId], references: [id])

  @@schema("sde")
}

model Planet {
  id             Int     @id
  solarSystemId  Int
  typeId         Int
  celestialIndex Int
  orbitId        Int
  radius         Int
  density        Float
  eccentricity   Float
  escapeVelocity Float
  locked         Boolean
  massDust       Float?
  massGas        Float?
  orbitPeriod    Float?
  orbitRadius    BigInt?
  pressure       Float
  rotationRate   Float
  spectralClass  String
  surfaceGravity Float?
  temperature    Float
  x              Float
  y              Float
  z              Float

  solarSystem SolarSystem @relation(fields: [solarSystemId], references: [id])

  @@schema("sde")
}

model Moon {
  id             Int      @id
  solarSystemId  Int
  typeId         Int
  celestialIndex Int
  orbitId        Int
  orbitIndex     Int
  radius         Int
  density        Float?
  eccentricity   Float?
  escapeVelocity Float?
  locked         Boolean?
  massDust       Float?
  massGas        Float?
  orbitPeriod    Float?
  orbitRadius    BigInt?
  pressure       Float?
  rotationRate   Float?
  spectralClass  String?
  surfaceGravity Float?
  temperature    Float?
  x              Float
  y              Float
  z              Float

  solarSystem SolarSystem @relation(fields: [solarSystemId], references: [id])

  @@schema("sde")
}
