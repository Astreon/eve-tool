{
    "name": "eve-toolkit",
    "private": true,
    "workspaces": [
        "backend",
        "frontend",
        "packages/db",
        "packages/sde",
        "packages/collector",
        "packages/logger",
        "worker"
    ],
    "scripts": {
        "dev": "npm run dev:backend",
        "dev:backend": "npm run dev --workspace backend",
        "dev:frontend": "npm run dev --workspace frontend",
        "dev:worker": "npm run dev --workspace worker",
        "type-check": "npm run type-check:backend && npm run type-check:frontend && npm run type-check:worker && npm run type-check:packages",
        "type-check:backend": "npm run type-check --workspace backend",
        "type-check:frontend": "npm run type-check --workspace frontend",
        "type-check:worker": "npm run type-check --workspace worker",
        "type-check:packages": "npm run type-check --workspace @eve-toolkit/db && npm run type-check --workspace @eve-toolkit/sde && npm run type-check --workspace @eve-toolkit/collector && npm run type-check --workspace @eve-toolkit/logger",
        "lint": "npm run lint:backend && npm run lint:frontend && npm run lint:worker && npm run lint:packages",
        "lint:backend": "npm run lint --workspace backend",
        "lint:frontend": "npm run lint --workspace frontend",
        "lint:worker": "npm run lint --workspace worker",
        "lint:packages": "npm run lint --workspace @eve-toolkit/sde && npm run lint --workspace @eve-toolkit/collector && npm run lint --workspace @eve-toolkit/logger",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss,html,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss,html,yml,yaml}\"",
        "test": "npm test --workspace backend",
        "sde:install": "npm run sde:install --workspace @eve-toolkit/sde",
        "sde:import": "npm run sde:import --workspace @eve-toolkit/sde",
        "sde:calculate": "npm run sde:calculate --workspace @eve-toolkit/sde",
        "sde:update": "npm run sde:update --workspace @eve-toolkit/sde",
        "sde:download": "npm run sde:download --workspace @eve-toolkit/sde",
        "sde:layout:export": "npm run layout:export --workspace @eve-toolkit/sde",
        "sde:layout:import": "npm run layout:import --workspace @eve-toolkit/sde"
    },
    "devDependencies": {
        "@types/node-cron": "^3.0.11",
        "pino-pretty": "^13.1.3"
    }
}
